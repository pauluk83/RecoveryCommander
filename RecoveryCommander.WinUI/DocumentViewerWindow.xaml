<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RecoveryCommanderWinUI.DocumentViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#030914">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#181818" Padding="16,12">
            <TextBlock x:Name="TitleTextBlock" Text="Document Viewer" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="DocumentTextBox"
                     Text="Document content"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#64FF8A"
                     Padding="16"/>
        </ScrollViewer>
    </Grid>
</Window>


