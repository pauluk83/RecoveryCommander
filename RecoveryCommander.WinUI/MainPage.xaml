<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="RecoveryCommanderWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RecoveryCommanderWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#030914">
        <Border Background="#B0030A14" />
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.72" RadiusY="0.72">
                    <GradientStop Color="#3518CFFF" Offset="0"/>
                    <GradientStop Color="#1000E5FF" Offset="0.38"/>
                    <GradientStop Color="#D0030914" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Padding="22,16,22,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Image Width="56" Height="56" Source="Assets/Logo.png" Stretch="UniformToFill"/>
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold">
                            <Run Text="Recovery" Foreground="White"/>
                            <Run Text="Commander" Foreground="#86A8FF"/>
                        </TextBlock>
                        <TextBlock Text="Professional Windows System Recovery &amp; Maintenance Tool" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="34" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding AdminStatus}" Foreground="{StaticResource AmberWarningBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OsStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="242" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="238" />
                    </Grid.ColumnDefinitions>

                <Grid>
                    <Border Style="{StaticResource GlassPanelStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="RECOVERY MODULES" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <ListView Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="48" ColumnSpacing="10" Padding="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="6" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="#3018CFFF">
                                                <TextBlock Text="+" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="166" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassPanelStyle}" Padding="0">
                        <Grid>
                            <Border>
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.68" RadiusY="0.68">
                                        <GradientStop Color="#7826D8FF" Offset="0"/>
                                        <GradientStop Color="#42178CDA" Offset="0.34"/>
                                        <GradientStop Color="#DB04111E" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="28,44,28,24" RowSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{Binding SelectedModule.Name, FallbackValue='RECOVERY ENGINE'}" Foreground="#D6F8FF" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedModule.Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <GridView Grid.Row="1" ItemsSource="{Binding SelectedModule.Actions}" SelectionMode="None" IsItemClickEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName, FallbackValue='{Binding Name}'}" Style="{StaticResource NeonButtonStyle}" Command="{Binding ElementName=RootGrid, Path=DataContext.RunActionCommand}" CommandParameter="{Binding}" MinWidth="210" MinHeight="58" Margin="5">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <Grid Grid.Row="2" HorizontalAlignment="Center" Width="420">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelActionCommand}" Style="{StaticResource NeonButtonStyle}" Padding="12,4" MinHeight="24" FontSize="11" Margin="0,0,0,8" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="8" Minimum="0" Maximum="100" Value="{Binding OperationProgress}" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border Style="{StaticResource GlassPanelStyle}">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="COMMAND FEED" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                <ScrollViewer x:Name="TerminalScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TerminalOutputBox"
                                             Text="{Binding TerminalOutput, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Foreground="#64FF8A"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             IsTabStop="False"
                                             SizeChanged="TerminalOutputBox_SizeChanged"/>
                                </ScrollViewer>
                                <Grid Grid.Row="2" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PS&gt;" Foreground="#64FF8A" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBox x:Name="TerminalInputBox"
                                             Grid.Column="1"
                                             PlaceholderText="Type a PowerShell command..."
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Foreground="#64FF8A"
                                             Background="#18001A2E"
                                             BorderThickness="1"
                                             BorderBrush="#40FFFFFF"
                                             CornerRadius="4"
                                             Padding="6,4"
                                             KeyDown="TerminalInputBox_KeyDown"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="166" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource GlassPanelStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="TOOLS" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="Restore Point Manager" Command="{Binding RestorePointManagerCommand}" Style="{StaticResource NeonButtonStyle}" Height="36" FontSize="11" Padding="12,0"/>
                            <Button Content="Startup Manager" Command="{Binding StartupManagerCommand}" Style="{StaticResource NeonButtonStyle}" Height="36" FontSize="11" Padding="12,0"/>
                            <Button Content="Network Repair &amp; Optimization" Command="{Binding NetworkRepairCommand}" Style="{StaticResource NeonButtonStyle}" Height="36" FontSize="11" Padding="12,0"/>
                            <Button Content="Media Tools" Command="{Binding MediaToolsCommand}" Style="{StaticResource NeonButtonStyle}" Height="36" FontSize="11" Padding="12,0"/>
                            <Button Content="Module Builder" Command="{Binding ModuleBuilderCommand}" Style="{StaticResource NeonButtonStyle}" Height="36" FontSize="11" Padding="12,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="SYSTEM HEALTH" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CpuStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding RamStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding NetworkStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="Disk Health: Good" Foreground="{StaticResource NeonSuccessBrush}" FontSize="12"/>
                            <Rectangle Height="1" Fill="{StaticResource PanelBorderBrush}" Margin="0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Modules" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding Modules.Count}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="1" Text="System Health" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Optimal" Foreground="{StaticResource NeonSuccessBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="2" Text="Last Scan" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Today" Foreground="{StaticResource AmberWarningBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="3" Text="RecoveryCommander" Foreground="{StaticResource DimTextBrush}" FontSize="10" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Up to date" Foreground="{StaticResource NeonSuccessBrush}" FontSize="10" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                    <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource TextButtonStyle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    <Button x:Name="HelpButton" Content="Help" Style="{StaticResource TextButtonStyle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="View README" Command="{Binding ViewReadmeCommand}"/>
                                <MenuFlyoutItem Text="View Changelog" Command="{Binding ViewChangelogCommand}"/>
                                <MenuFlyoutItem Text="View Architectural &amp; Design Notes" Command="{Binding ViewArchitecturalNotesCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource TextButtonStyle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    <Button Content="About" Command="{Binding AboutCommand}" Style="{StaticResource TextButtonStyle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>


