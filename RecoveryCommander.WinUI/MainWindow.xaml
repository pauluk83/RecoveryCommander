<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RecoveryCommanderWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RecoveryCommanderWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RecoveryCommander.WinUI"
    mc:Ignorable="d">
    <Grid Background="#030914">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Simplified title area to avoid platform-specific TitleBar control in Release builds -->
        <Border x:Name="AppTitleBar" Background="#030914" Height="40">
            <TextBlock Text="RecoveryCommander" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Border>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>


