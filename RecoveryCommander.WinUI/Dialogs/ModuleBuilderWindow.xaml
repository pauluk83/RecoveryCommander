<?xml version="1.0" encoding="utf-8"?>
<local:BaseWindowDialog
    x:Class="RecoveryCommanderWinUI.Dialogs.ModuleBuilderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecoveryCommanderWinUI.Dialogs"
    Title="Module Builder">

    <Grid RowSpacing="14" Padding="20" Width="1400" Height="850">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Color="#3518CFFF" Offset="0"/>
                <GradientStop Color="#1000E5FF" Offset="0.38"/>
                <GradientStop Color="#030914" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header description -->
            <Border Background="#14FFFFFF" CornerRadius="6" BorderBrush="#28FFFFFF"
                    BorderThickness="1" Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="MODULE BUILDER" FontSize="11" FontWeight="SemiBold" Foreground="#86A8FF"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#80FFFFFF">
                        Generate a C# module scaffold that implements IRecoveryModule. Fill in the details below
                        and the builder will produce ready-to-paste code you can drop into the Module/ directory.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Input Form -->
            <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="6"
                    BorderBrush="#28FFFFFF" BorderThickness="1" Padding="16,14">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: labels -->
                    <TextBlock Text="Module Name" FontSize="11" Foreground="#86A8FF"/>
                    <TextBlock Grid.Column="1" Text="Description" FontSize="11" Foreground="#86A8FF"/>
                    <TextBlock Grid.Column="2" Text="Template" FontSize="11" Foreground="#86A8FF"/>

                    <!-- Row 1: inputs -->
                    <TextBox x:Name="ModuleNameBox" Grid.Row="1"
                             PlaceholderText="e.g. MyCleanupModule"
                             FontFamily="Consolas" FontSize="12"
                             TextChanged="InputChanged"/>
                    <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1"
                             PlaceholderText="Short description of what this module does"
                             FontSize="12"
                             TextChanged="InputChanged"/>
                    <ComboBox x:Name="TemplateCombo" Grid.Row="1" Grid.Column="2"
                              HorizontalAlignment="Stretch" FontSize="12"
                              SelectionChanged="InputChanged">
                        <ComboBoxItem Content="Basic Action" IsSelected="True"/>
                        <ComboBoxItem Content="PowerShell Runner"/>
                        <ComboBoxItem Content="Download Tool"/>
                        <ComboBoxItem Content="Multi-Step"/>
                    </ComboBox>

                    <!-- Row 2: secondary options -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Version:" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="VersionBox" Text="1.0.0" Width="80"
                                 FontFamily="Consolas" FontSize="12"
                                 TextChanged="InputChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Action Name:" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="ActionNameBox" PlaceholderText="e.g. Run Cleanup" Width="160"
                                 FontSize="12"
                                 TextChanged="InputChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="⚡ Generate" Padding="14,8" FontSize="12"
                                Click="GenerateButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Code Preview -->
            <Border Grid.Row="2" Background="#0D000510" CornerRadius="6"
                    BorderBrush="#28FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="14,10,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GENERATED CODE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#86A8FF" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋 Copy" Padding="12,5" FontSize="11"
                                Click="CopyButton_Click"/>
                        <Button Grid.Column="2" Content="💾 Save to Module/" Padding="12,5" FontSize="11"
                                Margin="8,0,0,0"
                                Click="SaveButton_Click"/>
                        <Button Grid.Column="3" Content="📂 Open Modules Folder" Padding="12,5" FontSize="11"
                                Margin="8,0,0,0"
                                Click="OpenFolderButton_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="CodePreviewBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="#C8E6FF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="16,0,16,16"
                                 MinHeight="240"
                                 Text="← Fill in the form above and click Generate to see your module scaffold."/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#0AFFFFFF" CornerRadius="4" Padding="10,6">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Ready"
                               Foreground="#80FFFFFF" FontSize="11" FontFamily="Consolas"/>
                    <Button Content="Close" HorizontalAlignment="Right" Padding="12,6" Click="CloseButton_Click"/>
                </Grid>
            </Border>
    </Grid>
</local:BaseWindowDialog>
