<?xml version="1.0" encoding="utf-8"?>
<local:BaseWindowDialog
    x:Class="RecoveryCommanderWinUI.Dialogs.RestorePointManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecoveryCommanderWinUI.Dialogs"
    Title="Restore Point Manager">

    <Grid RowSpacing="16" Padding="20" Width="1200" Height="700">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Color="#3518CFFF" Offset="0"/>
                <GradientStop Color="#1000E5FF" Offset="0.38"/>
                <GradientStop Color="#030914" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
            <Grid.Resources>
                <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#86A8FF"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"
                           Text="SYSTEM RESTORE POINTS"/>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="↻ Refresh"
                        Click="RefreshButton_Click" Padding="12,6"/>
                <Button x:Name="CreateButton" Grid.Column="2" Content="+ Create New"
                        Click="CreateButton_Click" Padding="12,6"
                        Style="{ThemeResource AccentButtonStyle}"/>
                <Button Grid.Column="3" Content="Close" Padding="12,6" Click="CloseButton_Click"/>
            </Grid>

            <!-- Restore Point List -->
            <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="6"
                    BorderBrush="#28FFFFFF" BorderThickness="1">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="32" Height="32"/>
                        <TextBlock Text="Loading restore points..." Foreground="#80FFFFFF"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="No restore points found" FontSize="14"
                                   Foreground="#80FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create one using the button above."
                                   Foreground="#50FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ListView -->
                    <ListView x:Name="RestorePointsListView"
                              Visibility="Collapsed"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="8,10" MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                   Foreground="White" FontSize="13"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding CreationTime}"
                                                       Foreground="#80FFFFFF" FontSize="11"/>
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Foreground="#60AADDFF" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2018CFFF" CornerRadius="4"
                                            Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" Foreground="#18CFFF"
                                                   FontSize="11" FontFamily="Consolas"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Restore" VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="RestoreButton_Click"
                                            Padding="10,5" FontSize="11"/>
                                    <Button Grid.Column="3" Content="🗑" VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="DeleteButton_Click"
                                            Padding="8,5" FontSize="12"
                                            Foreground="#FF6B6B"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Create New Restore Point Panel -->
            <Border x:Name="CreatePanel" Grid.Row="2" Visibility="Collapsed"
                    Background="#14FFFFFF" CornerRadius="6"
                    BorderBrush="#28FFFFFF" BorderThickness="1" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DescriptionBox"
                             PlaceholderText="Restore point description (e.g. Before driver update)..."
                             FontSize="12" Background="#0CFFFFFF" BorderBrush="#30FFFFFF"/>
                    <Button Grid.Column="1" Content="Create" Padding="14,6"
                            Click="ConfirmCreateButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                    <Button Grid.Column="2" Content="Cancel" Padding="10,6"
                            Click="CancelCreateButton_Click"/>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#0AFFFFFF" CornerRadius="4" Padding="10,6">
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="#80FFFFFF" FontSize="11" FontFamily="Consolas"/>
            </Border>
    </Grid>
</local:BaseWindowDialog>
