<ContentDialog
    x:Class="RecoveryCommanderWinUI.Dialogs.CrashDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Application Crash"
    PrimaryButtonText="Copy to Clipboard"
    CloseButtonText="Exit"
    DefaultButton="Close">

    <ScrollViewer MaxHeight="500">
        <StackPanel Spacing="12">
            <TextBlock Text="⚠️ Application Crash" FontSize="20" FontWeight="SemiBold" Foreground="#FFD700"/>
            
            <TextBlock Text="RecoveryCommander encountered an unexpected error and needs to close." 
                       TextWrapping="Wrap"/>
            
            <Border Background="#1A1A1A" Padding="12" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Error Message:" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                    <TextBlock x:Name="ErrorMessageTextBlock" TextWrapping="Wrap" Foreground="#FFAAAA"/>
                    
                    <TextBlock Text="Stack Trace:" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#FF6B6B"/>
                    <TextBlock x:Name="StackTraceTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#FFAAAA"/>
                </StackPanel>
            </Border>
            
            <TextBlock Text="Please copy this error information and report it to the development team." 
                       TextWrapping="Wrap" 
                       FontStyle="Italic"
                       Foreground="#888888"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>


