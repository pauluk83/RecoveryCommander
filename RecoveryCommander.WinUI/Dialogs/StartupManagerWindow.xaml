<?xml version="1.0" encoding="utf-8"?>
<local:BaseWindowDialog
    x:Class="RecoveryCommanderWinUI.Dialogs.StartupManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RecoveryCommanderWinUI.Dialogs"
    Title="Startup Manager">

    <Grid RowSpacing="12" Padding="20" Width="1300" Height="700">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Color="#3518CFFF" Offset="0"/>
                <GradientStop Color="#1000E5FF" Offset="0.38"/>
                <GradientStop Color="#030914" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="STARTUP PROGRAMS" FontSize="12" FontWeight="SemiBold" Foreground="#86A8FF"/>
                    <TextBlock x:Name="SubtitleText" Text="Managing programs that run at Windows startup"
                               FontSize="11" Foreground="#60FFFFFF" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻ Refresh" Click="RefreshButton_Click" Padding="12,6"/>
                <ToggleButton x:Name="ShowAllToggle" Grid.Column="2" Content="Show All Scopes"
                              IsChecked="False" Padding="12,6" Click="ShowAllToggle_Click"/>
                <Button Grid.Column="3" Content="Close" Padding="12,6" Click="CloseButton_Click"/>
            </Grid>

            <!-- List -->
            <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="6"
                    BorderBrush="#28FFFFFF" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="32" Height="32"/>
                        <TextBlock Text="Loading startup items..." Foreground="#80FFFFFF"/>
                    </StackPanel>

                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="No startup items found" FontSize="14"
                                   Foreground="#80FFFFFF" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ListView x:Name="StartupListView"
                              Visibility="Collapsed"
                              SelectionMode="None"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4">
                        <ListView.Header>
                            <Grid Padding="12,8,12,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="On" FontSize="10" Foreground="#60FFFFFF" Grid.Column="0"/>
                                <TextBlock Text="Name" FontSize="10" Foreground="#60FFFFFF" Grid.Column="1"/>
                                <TextBlock Text="Command / Path" FontSize="10" Foreground="#60FFFFFF" Grid.Column="2"/>
                                <TextBlock Text="Location" FontSize="10" Foreground="#60FFFFFF" Grid.Column="3"/>
                                <TextBlock Text="Scope" FontSize="10" Foreground="#60FFFFFF" Grid.Column="4"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="12" MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Enable toggle -->
                                    <ToggleSwitch Grid.Column="0"
                                                  IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                  OnContent="" OffContent=""
                                                  MinWidth="0" Width="38"
                                                  Toggled="ItemToggled"
                                                  Tag="{Binding}"/>

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="White" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTipService.ToolTip="{Binding Name}"/>

                                    <!-- Command -->
                                    <TextBlock Grid.Column="2" Text="{Binding Command}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="#70FFFFFF" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTipService.ToolTip="{Binding Command}"/>

                                    <!-- Location -->
                                    <TextBlock Grid.Column="3" Text="{Binding Location}"
                                               FontSize="10" Foreground="#60A0C8FF"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTipService.ToolTip="{Binding Location}"/>

                                    <!-- Scope badge -->
                                    <Border Grid.Column="4" CornerRadius="4" Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{Binding ScopeBrush}">
                                        <TextBlock Text="{Binding ScopeLabel}"
                                                   FontSize="10" Foreground="White"/>
                                    </Border>

                                    <!-- Delete button -->
                                    <Button Grid.Column="5"
                                            Content="🗑"
                                            FontSize="12"
                                            Padding="4"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="DeleteItemButton_Click"
                                            Foreground="#FF6B6B"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="4" Padding="10,6">
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="#80FFFFFF" FontSize="11" FontFamily="Consolas"/>
            </Border>
    </Grid>
</local:BaseWindowDialog>
