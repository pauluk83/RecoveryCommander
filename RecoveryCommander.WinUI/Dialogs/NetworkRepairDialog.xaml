<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RecoveryCommanderWinUI.Dialogs.NetworkRepairDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Network Repair &amp; Optimization"
    CloseButtonText="Close"
    DefaultButton="Close">

    <Grid RowSpacing="14" MinHeight="680" MaxHeight="840" Width="1250">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Status Banner -->
        <Border x:Name="StatusBanner" Background="#2018CFFF" CornerRadius="6"
                BorderBrush="#4018CFFF" BorderThickness="1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#64FF8A"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" Text="Checking connection..."
                               FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                    <TextBlock x:Name="AdapterDetailsText" Text="—"
                               Foreground="#80FFFFFF" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="2" Content="↻ Refresh Status"
                        Click="RefreshStatusButton_Click" Padding="10,5" FontSize="11"/>
            </Grid>
        </Border>

        <!-- DNS Settings -->
        <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="6"
                BorderBrush="#28FFFFFF" BorderThickness="1" Padding="14,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="DNS SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="#86A8FF"/>
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AdapterCombo" PlaceholderText="Select adapter..."
                              HorizontalAlignment="Stretch" FontSize="12"/>
                    <ComboBox x:Name="DnsCombo" Grid.Column="1" FontSize="12"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Google DNS  (8.8.8.8)" Tag="8.8.8.8" IsSelected="True"/>
                        <ComboBoxItem Content="Cloudflare DNS  (1.1.1.1)" Tag="1.1.1.1"/>
                        <ComboBoxItem Content="OpenDNS  (208.67.222.222)" Tag="208.67.222.222"/>
                        <ComboBoxItem Content="Quad9  (9.9.9.9)" Tag="9.9.9.9"/>
                        <ComboBoxItem Content="AdGuard DNS  (94.140.14.14)" Tag="94.140.14.14"/>
                        <ComboBoxItem Content="DHCP (Automatic)" Tag="dhcp"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Apply DNS" Padding="14,8"
                            Click="ApplyDnsButton_Click"/>
                    <Button Grid.Column="3" Content="Flush DNS Cache" Padding="14,8"
                            Click="FlushDnsButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Repair Actions -->
        <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="6"
                BorderBrush="#28FFFFFF" BorderThickness="1" Padding="14,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="NETWORK REPAIR" FontSize="11" FontWeight="SemiBold" Foreground="#86A8FF"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="🔧  Reset Winsock" Padding="14,8" Click="ResetWinsockButton_Click"/>
                    <Button Content="🔄  Reset TCP/IP Stack" Padding="14,8" Click="ResetTcpButton_Click"/>
                    <Button Content="🔎  Diagnose &amp; Repair" Padding="14,8" Click="DiagnoseButton_Click"/>
                    <Border Width="1" Background="#28FFFFFF" Margin="4,0"/>
                    <!-- Ping Test inline -->
                    <TextBox x:Name="PingHostBox" Text="google.com" Width="130"
                             FontFamily="Consolas" FontSize="12" Padding="8,6"
                             PlaceholderText="host to ping"/>
                    <Button Content="Ping" Padding="14,8" Click="PingButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="6"
                BorderBrush="#28FFFFFF" BorderThickness="1">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="SemiBold"
                               Foreground="#86A8FF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Clear" Padding="10,4" FontSize="11"
                            Click="ClearLogButton_Click"/>
                </Grid>
                <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="ActivityLog"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="#64FF8A"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,0,14,14"
                             MinHeight="160"
                             SizeChanged="ActivityLog_SizeChanged"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar + progress -->
        <Border Grid.Row="4" Background="#0AFFFFFF" CornerRadius="4" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready"
                           Foreground="#80FFFFFF" FontSize="11" FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <ProgressRing x:Name="BusyRing" Grid.Column="1"
                              Width="18" Height="18" IsActive="False"
                              Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>


