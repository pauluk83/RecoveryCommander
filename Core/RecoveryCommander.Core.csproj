<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);NU1510;CA1303;CA1031;CA1805;CA1305;CA1822;CA1806;CA1051;CA1310;CA1311;CA1304;CA2000;CA1861;CA1862;CA1725;CA2201;CA1816;CA1848;CA1707;CA1860;CA1873</NoWarn>
    <DebugType>embedded</DebugType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Zane Stanton</Authors>
    <Company>RecoveryCommander Project</Company>
    <Description>Core infrastructure and common utilities for the RecoveryCommander system recovery toolkit.</Description>
    <PackageProjectUrl>https://github.com/pauluk83/RecoveryCommander</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pauluk83/RecoveryCommander.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>recovery, windows, system-prep, management</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecoveryCommander.Contracts\RecoveryCommander.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
  </ItemGroup>
</Project>
